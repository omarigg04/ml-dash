# MercadoLibre App Credentials
APP_ID=your_app_id_here
APP_SECRET=your_app_secret_here

# Redirect URI (cambiar según ambiente)
# Para desarrollo local (flujo manual)
REDIRECT_URI=https://your-domain.com
# Para producción en Vercel
# REDIRECT_URI=https://your-vercel-app.vercel.app/api/callback

PORT=3000

# Optional: Vercel KV for token persistence (auto-configured in Vercel)
# KV_REST_API_URL=your_kv_rest_api_url
# KV_REST_API_TOKEN=your_kv_rest_api_token


# IA (Oportunidades y Cargas masivas). Por defecto: Google Gemini, plan gratuito.
# Clave gratis (sin tarjeta) en https://aistudio.google.com/apikey - solo servidor, nunca en el front.
GEMINI_API_KEY=
# Modelo (opcional). Por defecto gemini-3.5-flash-lite (con plan gratuito segun la pagina de precios de Google).
# GEMINI_MODEL=gemini-3.5-flash-lite
# Proveedor: 'gemini' (por defecto). 'anthropic' es OPCIONAL y DE PAGO; solo corre si lo pides aqui.
# AI_PROVIDER=gemini
# Opcional y de pago, solo con AI_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=
# Limite diario de generaciones por cuenta (por defecto 20)
# AI_DAILY_LIMIT=20
